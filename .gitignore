!.env.example
*.bak

# --- local scratch, logs, throwaway pollers ---
artifacts/
*.log

# --- python ---
.venv/
__pycache__/
*.py[cod]

# --- generated at run time; every one of these is rebuilt by a script ---
# report.html      <- report.py
# state.json       <- live.py (also the workflow fixture's own state file)
# report_url.json  <- report.py, signed URL expires after 3600s
# fix_events.json  <- fixer.py --live, replayed by livesweep.py --replay-fix
report.html
state.json
report_url.json
fix_events.json
.deployment_id
.deployment_id_qwen36

# --- workflow fixture leftovers, if a local run drops them in the repo root ---
cache.json
cache.json.corrupt
ledger.txt
error.txt

